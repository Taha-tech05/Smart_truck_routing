# Copy to .env (never commit .env) and fill in ORS_API_KEY.
# Free key: https://openrouteservice.org/dev/#/signup

# Django
SECRET_KEY=change-me-to-a-long-random-string
DEBUG=False
ALLOWED_HOSTS=localhost,127.0.0.1
# Must match the address you open the frontend on (scheme + host + port)
CORS_ALLOWED_ORIGINS=http://localhost:5173

# OpenRouteService: routing, geocoding and place names (required)
ORS_API_KEY=

# Optional: paid Open-Meteo key. Leave empty for the free API (rate limited per IP; shared hosts may hit 429)
OPEN_METEO_API_KEY=

# Free fallback (MET Norway) when Open-Meteo is over its quota. MET asks for an identifying User-Agent,
# e.g. "my-app/1.0 you@example.com". Set WEATHER_FALLBACK_ENABLED=False to disable the fallback.
# MET_USER_AGENT=
# WEATHER_FALLBACK_ENABLED=True

# Optional: where the BROWSER reaches the backend (baked into the frontend at build time)
# VITE_API_BASE_URL=http://localhost:8000
